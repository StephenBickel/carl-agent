[Unit]
Description=Carl protected coordinator GitHub effect socket

[Socket]
Service=carl-github-effect.service
FileDescriptorName=github-effect
ListenStream=/run/carl/github-effect.sock
DirectoryMode=0711
SocketMode=0600
SocketUser=carl-autonomy-coordinator
SocketGroup=carl-autonomy-coordinator
RemoveOnStop=false

[Install]
WantedBy=sockets.target
