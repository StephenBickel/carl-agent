[Unit]
Description=Carl protected archive effect socket

[Socket]
Service=carl-archive-effect.service
FileDescriptorName=archive-effect
ListenStream=/run/carl/archive-effect.sock
DirectoryMode=0711
SocketMode=0600
SocketUser=carl-autonomy-coordinator
SocketGroup=carl-autonomy-coordinator
RemoveOnStop=false

[Install]
WantedBy=sockets.target
