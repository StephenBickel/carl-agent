[Unit]
Description=Carl protected live evidence evaluator
Requires=carl-live-evaluator.socket

[Service]
Type=simple
ExecStart=/opt/carl/venv/bin/carl-live-evaluation-service
EnvironmentFile=/etc/carl/live-evaluator.env
User=root
Group=root
Delegate=pids
TasksMax=256
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=no
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/carl/checkouts
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=carl
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
