[Unit]
Description=Carl protected observer effect socket

[Socket]
Service=carl-observer-effect.service
FileDescriptorName=observer-effect
ListenStream=/run/carl/observer-effect.sock
DirectoryMode=0711
SocketMode=0600
SocketUser=carl-autonomy-coordinator
SocketGroup=carl-autonomy-coordinator
RemoveOnStop=false

[Install]
WantedBy=sockets.target
