{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsValidator",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": ${database_user_arn}
    },
    {
      "Sid": "ReadPrivateHoldouts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAttributes"],
      "Resource": ${input_object_arn}
    },
    {
      "Sid": "DecryptPrivateHoldouts",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey"],
      "Resource": ${storage_key_arn}
    },
    {
      "Sid": "ReadValidatorModelCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": ${secret_arn}
    }
  ]
}
