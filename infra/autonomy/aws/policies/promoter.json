{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsPromoter",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": ${database_user_arn}
    },
    {
      "Sid": "ReadPromotionAppCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": ${secret_arn}
    }
  ]
}
