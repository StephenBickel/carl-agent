{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsSoak",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": ${database_user_arn}
    },
    {
      "Sid": "ReadSoakInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAttributes"],
      "Resource": ${input_object_arn}
    },
    {
      "Sid": "DecryptSoakInputs",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey"],
      "Resource": ${storage_key_arn}
    },
    {
      "Sid": "ReadExactRevertAppCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": ${secret_arn}
    }
  ]
}
