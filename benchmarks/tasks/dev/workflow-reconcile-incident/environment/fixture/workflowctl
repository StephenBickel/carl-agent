#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data"
LOG = ROOT / ".workflow-log.jsonl"


def read_store(name: str) -> list[dict[str, Any]]:
    return json.loads((DATA / f"{name}.json").read_text(encoding="utf-8"))


def write_store(name: str, value: list[dict[str, Any]]) -> None:
    (DATA / f"{name}.json").write_text(
        json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def record(kind: str, target: str) -> None:
    with LOG.open("a", encoding="utf-8") as output:
        output.write(json.dumps({"kind": kind, "target": target}, sort_keys=True) + "\n")


def find(records: list[dict[str, Any]], key: str, value: str) -> dict[str, Any]:
    return next(record for record in records if record[key] == value)


parser = argparse.ArgumentParser()
services = parser.add_subparsers(dest="service", required=True)

inbox = services.add_parser("inbox").add_subparsers(dest="action", required=True)
inbox_get = inbox.add_parser("get")
inbox_get.add_argument("message_id")

incident = services.add_parser("incident").add_subparsers(dest="action", required=True)
incident_get = incident.add_parser("get")
incident_get.add_argument("incident_id")
incident_update = incident.add_parser("update")
incident_update.add_argument("incident_id")
incident_update.add_argument("--status", required=True)
incident_update.add_argument("--owner", required=True)

calendar = services.add_parser("calendar").add_subparsers(dest="action", required=True)
calendar_on_call = calendar.add_parser("on-call")
calendar_on_call.add_argument("timestamp")

sheet = services.add_parser("sheet").add_subparsers(dest="action", required=True)
sheet_get = sheet.add_parser("get")
sheet_get.add_argument("service_name")
sheet_update = sheet.add_parser("update")
sheet_update.add_argument("service_name")
sheet_update.add_argument("--status", required=True)
sheet_update.add_argument("--incident", required=True)
sheet_update.add_argument("--owner", required=True)

audit = services.add_parser("audit").add_subparsers(dest="action", required=True)
audit_append = audit.add_parser("append")
audit_append.add_argument("--event-id", required=True)
audit_append.add_argument("--incident", required=True)
audit_append.add_argument("--message", required=True)
audit_append.add_argument("--owner", required=True)

arguments = parser.parse_args()

if arguments.service == "inbox":
    value = find(read_store("inbox"), "message_id", arguments.message_id)
    record("read", f"inbox:{arguments.message_id}")
elif arguments.service == "calendar":
    value = next(
        shift
        for shift in read_store("calendar")
        if shift["starts_at"] <= arguments.timestamp < shift["ends_at"]
    )
    record("read", f"calendar:{arguments.timestamp}")
elif arguments.service == "incident" and arguments.action == "get":
    value = find(read_store("incidents"), "incident_id", arguments.incident_id)
    record("read", f"incident:{arguments.incident_id}")
elif arguments.service == "sheet" and arguments.action == "get":
    value = find(read_store("sheet"), "service", arguments.service_name)
    record("read", f"sheet:{arguments.service_name}")
elif arguments.service == "incident":
    records = read_store("incidents")
    value = find(records, "incident_id", arguments.incident_id)
    value.update({"status": arguments.status, "owner": arguments.owner})
    write_store("incidents", records)
    record("write", f"incident:{arguments.incident_id}")
elif arguments.service == "sheet":
    records = read_store("sheet")
    value = find(records, "service", arguments.service_name)
    value.update(
        {"status": arguments.status, "incident_id": arguments.incident, "owner": arguments.owner}
    )
    write_store("sheet", records)
    record("write", f"sheet:{arguments.service_name}")
else:
    records = read_store("audit")
    if any(entry["event_id"] == arguments.event_id for entry in records):
        raise SystemExit("event ID already exists")
    value = {
        "event_id": arguments.event_id,
        "action": "incident_reconciled",
        "incident_id": arguments.incident,
        "message_id": arguments.message,
        "owner": arguments.owner,
        "created_at": "2026-08-10T20:05:00Z",
    }
    records.append(value)
    write_store("audit", records)
    record("write", f"audit:{arguments.event_id}")

print(json.dumps(value, sort_keys=True))
